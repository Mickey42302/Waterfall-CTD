+++ b/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandCallback.java
@@ -0,0 +1,55 @@
+package com.mickey42302.waterfallctd.command;
+
+import com.google.common.cache.Cache;
+import com.google.common.cache.CacheBuilder;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Consumer;
+import net.md_5.bungee.api.ChatColor;
+import net.md_5.bungee.api.CommandSender;
+import net.md_5.bungee.api.chat.TextComponent;
+import net.md_5.bungee.api.plugin.Command;
+
+public class CommandCallback extends Command {
+
+    private static final Cache<UUID, Consumer<CommandSender>> REGISTERED_CALLBACKS = CacheBuilder.newBuilder()
+             .expireAfterWrite(10, TimeUnit.MINUTES)
+             .build();
+
+    public CommandCallback() {
+        super("waterfall:callback", "waterfall.command.callback");
+    }
+
+    public static String registerCallback(Consumer<CommandSender> callback) {
+        UUID id = UUID.randomUUID();
+        REGISTERED_CALLBACKS.put(id, callback);
+        return "/waterfall:callback " + id.toString();
+    }
+
+    @Override
+    public void execute(CommandSender sender, String[] args) {
+        if (args.length == 0) {
+            return;
+        }
+
+        try {
+            UUID id = UUID.fromString(args[0]);
+            Consumer<CommandSender> callback = REGISTERED_CALLBACKS.asMap().remove(id);
+
+            if (callback != null) {
+                callback.accept(sender);
+                if (sender.hasPermission("waterfall.command.callback.output")) {
+                    sender.sendMessage(TextComponent.fromLegacyText(ChatColor.GREEN + "A callback has been triggered using the " + id.toString() + " identifier."));
+                }
+            } else {
+                if (sender.hasPermission("waterfall.command.callback.output")) {
+                    sender.sendMessage(TextComponent.fromLegacyText(ChatColor.RED + "This callback has expired or is invalid."));
+                }
+            }
+        } catch (IllegalArgumentException e) {
+            if (sender.hasPermission("waterfall.command.callback.output")) {
+                sender.sendMessage(TextComponent.fromLegacyText(ChatColor.RED + "Invalid callback token format."));
+            }
+        }
+    }
+}
\ No newline at end of file
