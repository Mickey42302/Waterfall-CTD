@@ -0,0 +1,115 @@
+package com.mickey42302.waterfallctd.command;
+
+import net.md_5.bungee.api.ChatColor;
+import net.md_5.bungee.api.CommandSender;
+import net.md_5.bungee.api.ProxyServer;
+import net.md_5.bungee.api.connection.ProxiedPlayer;
+import net.md_5.bungee.api.plugin.Command;
+import net.md_5.bungee.api.plugin.TabExecutor;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+
+public class CommandSudo extends Command implements TabExecutor
+{
+
+    public CommandSudo()
+    {
+        super("gsudo", "waterfall.command.sudo");
+    }
+
+    @Override
+    public void execute(CommandSender sender, String[] args)
+    {
+        if (args.length < 2)
+        {
+            sender.sendMessage(ChatColor.RED + "Usage: /gsudo <player> <command>");
+            return;
+        }
+
+        ProxiedPlayer target = ProxyServer.getInstance().getPlayer(args[0]);
+
+        if (target == null)
+        {
+            sender.sendMessage(ChatColor.RED + "Player '" + args[0] + "' not found.");
+            return;
+        }
+
+        StringBuilder commandBuilder = new StringBuilder();
+        for (int i = 1; i < args.length; i++)
+        {
+            commandBuilder.append(args[i]).append(" ");
+        }
+
+        String commandToRun = commandBuilder.toString().trim();
+
+        if (commandToRun.startsWith("/"))
+        {
+            commandToRun = commandToRun.substring(1);
+        }
+
+        boolean success = ProxyServer.getInstance().getPluginManager().dispatchCommand(target, commandToRun);
+
+        if (success)
+        {
+            sender.sendMessage(ChatColor.GREEN + "Successfully forced " + target.getName() + " to run: /" + commandToRun);
+        }
+        else
+        {
+            sender.sendMessage(ChatColor.RED + "Failed to execute command as " + target.getName());
+        }
+    }
+
+    @Override
+    public Iterable<String> onTabComplete(CommandSender sender, String[] args)
+    {
+        List<String> completions = new ArrayList<>();
+
+        if (args.length == 1)
+        {
+            String partialName = args[0].toLowerCase();
+            for (ProxiedPlayer player : ProxyServer.getInstance().getPlayers())
+            {
+                if (player.getName().toLowerCase().startsWith(partialName))
+                {
+                    completions.add(player.getName());
+                }
+            }
+        }
+        else if (args.length == 2)
+        {
+            String partialCommand = args[1].toLowerCase();
+
+            if (partialCommand.startsWith("/"))
+            {
+                partialCommand = partialCommand.substring(1);
+            }
+
+            ProxiedPlayer target = ProxyServer.getInstance().getPlayer(args[0]);
+
+            if (target != null)
+            {
+                Collection<Map.Entry<String, Command>> proxyCommands =
+                        ProxyServer.getInstance().getPluginManager().getCommands();
+
+                for (Map.Entry<String, Command> entry : proxyCommands)
+                {
+                    String commandName = entry.getKey();
+                    Command cmd = entry.getValue();
+
+                    if (commandName.toLowerCase().startsWith(partialCommand))
+                    {
+                        if (cmd.getPermission() == null || cmd.getPermission().isEmpty() || target.hasPermission(cmd.getPermission()))
+                        {
+                            completions.add(commandName);
+                        }
+                    }
+                }
+            }
+        }
+
+        return completions;
+    }
+}
\ No newline at end of file
