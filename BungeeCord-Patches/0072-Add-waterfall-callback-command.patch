--- /dev/null
+++ b/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandCallback.java
@@ -0,0 +1,150 @@
+package com.mickey42302.waterfallctd.command;
+
+import com.google.common.cache.Cache;
+import com.google.common.cache.CacheBuilder;
+import java.time.Duration;
+import java.util.Collections;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import net.md_5.bungee.BungeeCord;
+import net.md_5.bungee.api.ChatColor;
+import net.md_5.bungee.api.CommandSender;
+import net.md_5.bungee.api.chat.TextComponent;
+import net.md_5.bungee.api.connection.ProxiedPlayer;
+import net.md_5.bungee.api.plugin.Command;
+import net.md_5.bungee.api.plugin.TabExecutor;
+
+public class CommandCallback extends Command implements TabExecutor {
+
+  public static final int UNLIMITED_USES = -1;
+  private static final Duration MAX_LIFETIME = Duration.ofHours(1);
+
+  private static final Cache<UUID, CallbackEntry> REGISTERED_CALLBACKS = CacheBuilder.newBuilder()
+      .expireAfterWrite(MAX_LIFETIME.toMillis(), TimeUnit.MILLISECONDS)
+      .build();
+
+  public CommandCallback() {
+    super("waterfall:callback");
+  }
+
+  public static String registerCallback(Consumer<CommandSender> callback) {
+    return registerCallback(null, callback, 1, Duration.ofMinutes(10));
+  }
+
+  public static String registerCallback(ProxiedPlayer target, Consumer<CommandSender> callback) {
+    return registerCallback(target != null ? target.getUniqueId() : null, callback, 1, Duration.ofMinutes(10));
+  }
+
+  public static String registerCallback(UUID targetUuid, Consumer<CommandSender> callback, int uses, Duration lifetime) {
+    UUID id = UUID.randomUUID();
+    long expiresAt = System.currentTimeMillis() + Math.min(lifetime.toMillis(), MAX_LIFETIME.toMillis());
+    REGISTERED_CALLBACKS.put(id, new CallbackEntry(targetUuid, callback, uses, expiresAt));
+    return "/waterfall:callback " + id;
+  }
+
+  @Override
+  public void execute(CommandSender sender, String[] args) {
+    if (BungeeCord.getInstance().getConfig().isCallbackPermission()
+        && !sender.hasPermission("waterfall.command.callback")) {
+      sender.sendMessage(TextComponent.fromLegacyText(ChatColor.RED + "You do not have permission to execute this command."));
+      return;
+    }
+
+    if (args.length == 0) {
+      sendDebug(sender, ChatColor.RED + "Usage: /waterfall:callback <id>");
+      return;
+    }
+
+    UUID id;
+    try {
+      id = UUID.fromString(args[0]);
+    } catch (IllegalArgumentException e) {
+      sendDebug(sender, ChatColor.RED + "Invalid callback token format.");
+      return;
+    }
+
+    CallbackEntry entry = REGISTERED_CALLBACKS.getIfPresent(id);
+    if (entry == null || entry.isExpired()) {
+      REGISTERED_CALLBACKS.invalidate(id);
+      sendDebug(sender, ChatColor.RED + "This callback has expired or is invalid.");
+      return;
+    }
+
+    if (!entry.canUse(sender)) {
+      sendDebug(sender, ChatColor.RED + "You are not authorized to trigger this callback.");
+      return;
+    }
+
+    if (!entry.consumeUse()) {
+      REGISTERED_CALLBACKS.invalidate(id);
+      sendDebug(sender, ChatColor.RED + "This callback has already been used.");
+      return;
+    }
+
+    if (entry.isExhausted()) {
+      REGISTERED_CALLBACKS.invalidate(id);
+    }
+
+    entry.callback.accept(sender);
+    sendDebug(sender, ChatColor.GREEN + "A callback has been triggered using the " + ChatColor.WHITE + id + ChatColor.GREEN + " identifier.");
+  }
+
+  @Override
+  public Iterable<String> onTabComplete(CommandSender sender, String[] args) {
+    return Collections.emptyList();
+  }
+
+  private void sendDebug(CommandSender sender, String message) {
+    if (BungeeCord.getInstance().getConfig().isCallbackOutput()
+        && sender.hasPermission("waterfall.command.callback.output")) {
+      sender.sendMessage(TextComponent.fromLegacyText(message));
+    }
+  }
+
+  private static class CallbackEntry {
+    private final UUID targetUuid;
+    private final Consumer<CommandSender> callback;
+    private final AtomicInteger remainingUses;
+    private final boolean unlimited;
+    private final long expiresAt;
+
+    CallbackEntry(UUID targetUuid, Consumer<CommandSender> callback, int uses, long expiresAt) {
+      this.targetUuid = targetUuid;
+      this.callback = callback;
+      this.unlimited = (uses == UNLIMITED_USES);
+      this.remainingUses = new AtomicInteger(Math.max(1, uses));
+      this.expiresAt = expiresAt;
+    }
+
+    boolean isExpired() {
+      return System.currentTimeMillis() > expiresAt;
+    }
+
+    boolean canUse(CommandSender sender) {
+      if (targetUuid == null) {
+        return true;
+      }
+      return sender instanceof ProxiedPlayer && ((ProxiedPlayer) sender).getUniqueId().equals(targetUuid);
+    }
+
+    boolean consumeUse() {
+      if (unlimited) {
+        return true;
+      }
+      int current;
+      do {
+        current = remainingUses.get();
+        if (current <= 0) {
+          return false;
+        }
+      } while (!remainingUses.compareAndSet(current, current - 1));
+      return true;
+    }
+
+    boolean isExhausted() {
+      return !unlimited && remainingUses.get() <= 0;
+    }
+  }
+}
\ No newline at end of file
