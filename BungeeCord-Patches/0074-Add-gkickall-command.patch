index 00000000..77e27cc4
--- /dev/null
+++ b/module/cmd-kick/src/main/java/com/mickey42302/waterfallctd/module/cmd/kick/CommandKickAll.java
@@ -0,0 +1,139 @@
+package com.mickey42302.waterfallctd.module.cmd.kick;
+
+import com.google.common.base.Joiner;
+import com.google.common.collect.ImmutableSet;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import net.md_5.bungee.api.ChatColor;
+import net.md_5.bungee.api.CommandSender;
+import net.md_5.bungee.api.ProxyServer;
+import net.md_5.bungee.api.chat.BaseComponent;
+import net.md_5.bungee.api.chat.TextComponent;
+import net.md_5.bungee.api.config.ServerInfo;
+import net.md_5.bungee.api.connection.ProxiedPlayer;
+import net.md_5.bungee.api.plugin.Command;
+import net.md_5.bungee.api.plugin.TabExecutor;
+
+public class CommandKickAll extends Command implements TabExecutor
+{
+
+    public CommandKickAll()
+    {
+        super( "gkickall", "waterfall.command.kickall" );
+    }
+
+    @Override
+    public void execute(CommandSender sender, String[] args)
+    {
+        if ( args.length == 0 )
+        {
+            sender.sendMessage( TextComponent.fromLegacy( ChatColor.RED + "Usage: /gkickall <proxy|server> [serverName] [reason]" ) );
+            return;
+        }
+
+        String subCommand = args[0].toLowerCase( Locale.ROOT );
+
+        if ( subCommand.equals( "proxy" ) )
+        {
+            java.util.Collection<ProxiedPlayer> players = ProxyServer.getInstance().getPlayers();
+
+            if ( players.isEmpty() )
+            {
+                sender.sendMessage( TextComponent.fromLegacy( ChatColor.RED + "There are no players online on the proxy." ) );
+                return;
+            }
+
+            BaseComponent[] reason = getKickReason( args, 1 );
+
+            for ( ProxiedPlayer player : players )
+            {
+                player.disconnect( reason );
+            }
+            sender.sendMessage( TextComponent.fromLegacy( ChatColor.GREEN + "Kicked all players (" + players.size() + ") from the proxy." ) );
+        }
+        else if ( subCommand.equals( "server" ) )
+        {
+            if ( args.length < 2 )
+            {
+                sender.sendMessage( TextComponent.fromLegacy( ChatColor.RED + "Usage: /gkickall server <name> [reason]" ) );
+                return;
+            }
+
+            String targetServerName = args[1];
+            ServerInfo server = ProxyServer.getInstance().getServerInfo( targetServerName );
+
+            if ( server == null )
+            {
+                sender.sendMessage( TextComponent.fromLegacy( ChatColor.RED + "The '" + targetServerName + "' server was not found." ) );
+                return;
+            }
+
+            java.util.Collection<ProxiedPlayer> players = server.getPlayers();
+
+            if ( players.isEmpty() )
+            {
+                sender.sendMessage( TextComponent.fromLegacy( ChatColor.RED + "No players were found on the '" + server.getName() + "' server." ) );
+                return;
+            }
+
+            BaseComponent[] reason = getKickReason( args, 2 );
+
+            for ( ProxiedPlayer player : players )
+            {
+                player.disconnect( reason );
+            }
+            sender.sendMessage( TextComponent.fromLegacy( ChatColor.GREEN + "Kicked all players (" + players.size() + ") from the '" + server.getName() + "' server." ) );
+        }
+        else
+        {
+            sender.sendMessage( TextComponent.fromLegacy( ChatColor.RED + "Invalid argument. Use 'proxy' or 'server'." ) );
+        }
+    }
+
+    private BaseComponent[] getKickReason(String[] args, int startIdx)
+    {
+        if ( args.length <= startIdx )
+        {
+            String defaultMsg = ProxyServer.getInstance().getTranslation( "kick_message" );
+            return new BaseComponent[]{ TextComponent.fromLegacy( defaultMsg != null ? defaultMsg : "Kicked by an operator." ) };
+        }
+
+        String[] reasonArgs = new String[ args.length - startIdx ];
+        System.arraycopy( args, startIdx, reasonArgs, 0, reasonArgs.length );
+        return new BaseComponent[]{ TextComponent.fromLegacy( ChatColor.translateAlternateColorCodes( '&', Joiner.on( ' ' ).join( reasonArgs ) ) ) };
+    }
+
+    @Override
+    public Iterable<String> onTabComplete(CommandSender sender, String[] args)
+    {
+        if ( args.length == 1 )
+        {
+            List<String> matches = new ArrayList<>();
+            String search = args[0].toLowerCase( Locale.ROOT );
+
+            if ( "proxy".startsWith( search ) ) matches.add( "proxy" );
+            if ( "server".startsWith( search ) ) matches.add( "server" );
+
+            return matches;
+        }
+        else if ( args.length == 2 && args[0].equalsIgnoreCase( "server" ) )
+        {
+            Set<String> matches = new HashSet<>();
+            String search = args[1].toLowerCase( Locale.ROOT );
+
+            for ( String serverName : ProxyServer.getInstance().getServers().keySet() )
+            {
+                if ( serverName.toLowerCase( Locale.ROOT ).startsWith( search ) )
+                {
+                    matches.add( serverName );
+                }
+            }
+            return matches;
+        }
+
+        return ImmutableSet.of();
+    }
+}
\ No newline at end of file
