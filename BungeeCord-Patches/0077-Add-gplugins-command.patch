Subject: [PATCH] Add /gplugins command


diff --git a/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandPlugins.java b/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandPlugins.java
new file mode 100644
index 00000000..bbacfcd3
--- /dev/null
+++ b/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandPlugins.java
@@ -0,0 +1,37 @@
+package com.mickey42302.waterfallctd.command;
+
+import net.md_5.bungee.api.ChatColor;
+import net.md_5.bungee.api.CommandSender;
+import net.md_5.bungee.api.ProxyServer;
+import net.md_5.bungee.api.plugin.Command;
+import net.md_5.bungee.api.plugin.Plugin;
+
+import java.util.Collection;
+import java.util.stream.Collectors;
+
+public class CommandPlugins extends Command
+{
+
+    public CommandPlugins()
+    {
+        super("gplugins", "waterfall.command.plugins", "gpl");
+    }
+
+    @Override
+    public void execute(CommandSender sender, String[] args)
+    {
+        Collection<Plugin> plugins = ProxyServer.getInstance().getPluginManager().getPlugins();
+
+        if (plugins.isEmpty())
+        {
+            sender.sendMessage(ChatColor.RED + "No plugins/modules are currently installed.");
+            return;
+        }
+
+        String pluginList = plugins.stream()
+                .map(plugin -> ChatColor.AQUA + plugin.getDescription().getName() + ChatColor.WHITE)
+                .collect(Collectors.joining(", "));
+
+        sender.sendMessage(ChatColor.BLUE + "Plugins/Modules (" + plugins.size() + "): " + pluginList);
+    }
+}
\ No newline at end of file
