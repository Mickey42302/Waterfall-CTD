Subject: [PATCH] Add /ghelp command


diff --git a/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandHelp.java b/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandHelp.java
new file mode 100644
index 00000000..5e5448c1
--- /dev/null
+++ b/proxy/src/main/java/com/mickey42302/waterfallctd/command/CommandHelp.java
@@ -0,0 +1,45 @@
+package com.mickey42302.waterfallctd.command;
+
+import net.md_5.bungee.api.ChatColor;
+import net.md_5.bungee.api.CommandSender;
+import net.md_5.bungee.api.ProxyServer;
+import net.md_5.bungee.api.plugin.Command;
+import java.util.Collection;
+import java.util.Map;
+
+public class CommandHelp extends Command
+{
+
+    public CommandHelp()
+    {
+        super("ghelp", "waterfall.command.help");
+    }
+
+    @Override
+    public void execute(CommandSender sender, String[] args)
+    {
+        sender.sendMessage(ChatColor.BLUE + "----- Help -----");
+
+        Collection<Map.Entry<String, Command>> commands = ProxyServer.getInstance().getPluginManager().getCommands();
+
+        boolean foundCommands = false;
+
+        for (Map.Entry<String, Command> entry : commands)
+        {
+            String commandName = entry.getKey();
+            Command command = entry.getValue();
+
+            if (command.getPermission() == null || command.getPermission().isEmpty() || sender.hasPermission(command.getPermission()))
+            {
+                sender.sendMessage(ChatColor.WHITE + "/" + commandName);
+                foundCommands = true;
+            }
+        }
+
+        if (!foundCommands)
+        {
+            sender.sendMessage(ChatColor.RED + "You do not have access to any commands.");
+        }
+
+    }
+}
\ No newline at end of file
