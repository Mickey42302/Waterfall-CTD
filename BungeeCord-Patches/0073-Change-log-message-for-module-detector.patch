From 6d34a8e79441cae4c4baced4731511cd98c72d33 Mon Sep 17 00:00:00 2001
From: Mickey42302 <bgoodwin423@gmail.com>
Date: Wed, 11 Nov 2026 17:07:58 -0500
Subject: [PATCH] Change log message for module detector


diff --git a/proxy/src/main/java/net/md_5/bungee/module/ModuleManager.java b/proxy/src/main/java/net/md_5/bungee/module/ModuleManager.java
index c925f14d..3b5fd4fd 100644
--- a/proxy/src/main/java/net/md_5/bungee/module/ModuleManager.java
+++ b/proxy/src/main/java/net/md_5/bungee/module/ModuleManager.java
@@ -110,7 +110,7 @@ public class ModuleManager
 
             ModuleSpec spec = new ModuleSpec( name, new File( moduleDirectory, name + ".jar" ), source );
             modules.add( spec );
-            proxy.getLogger().info( "Discovered module: " + spec );
+            proxy.getLogger().info( "Checking for module: " + spec );
         }
 
         ModuleVersion bungeeVersion = ModuleVersion.parse( proxy.getVersion() );
